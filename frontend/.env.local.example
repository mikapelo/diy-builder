# ───────────────────────────────────────────────────────────────────
# Variables d'environnement — DIY Builder
#
# Copier ce fichier vers .env.local et remplir les valeurs réelles.
# .env.local est gitignored — ne JAMAIS commit de secrets.
# ───────────────────────────────────────────────────────────────────

# ── Analytics (client-side, public) ────────────────────────────────

# Analytics Umami — privacy-first, CNIL-exempt (pas de bannière de consentement)
# Self-host actuel : instance Vercel (script servi via NEXT_PUBLIC_UMAMI_SRC).
# Website ID visible dans le HTML live (data-website-id) ou le dashboard Umami.
# Laisser vide en dev pour désactiver le tracking.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Source du script Umami. Vide = Cloud (https://cloud.umami.is/script.js).
# Self-host : URL de l'instance, ex. https://umami-xxxx.vercel.app/script.js
NEXT_PUBLIC_UMAMI_SRC=

# Meta Pixel (Facebook/Instagram) — ID public, chargé après consentement RGPD.
# Laisser vide pour désactiver complètement le pixel.
NEXT_PUBLIC_META_PIXEL_ID=

# ── Backend (server-only, secret) ──────────────────────────────────

# Resend API key — envoi d'emails transactionnels (devis, leads).
# Obtenir sur https://resend.com/api-keys
# Format : re_xxxxxxxxxxxx
RESEND_API_KEY=

# Adresse de réception des notifications de leads (admin/owner).
# Défaut : contact@diy-builder.fr si non défini.
LEAD_NOTIFY_EMAIL=

# Redis (Vercel KV / Upstash / self-hosted ioredis-compatible).
# Format : redis://... ou rediss://... (TLS).
# Auto-injecté par Vercel Storage si l'intégration est branchée.
REDIS_URL=

# Mot de passe admin pour /api/admin/leads (Basic Auth).
# REQUIS : minimum 16 caractères. Sinon l'endpoint est verrouillé.
# Générer un mot de passe long : `openssl rand -base64 24`
ADMIN_PASSWORD=

# ── Scripts monitoring/API (server-only, secret) ───────────────────

# Awin Publisher API — token OAuth2 pour scripts/awin-stats.js
# (programmes, commission, transactions, performance).
# Obtenir sur https://ui.awin.com → Account > API credentials.
AWIN_API_TOKEN=
# Optionnels : forcer publisherId / région (défaut auto = 2934749 / FR).
# AWIN_PUBLISHER_ID=
# AWIN_REGION=FR

# Bing Webmaster API — clé pour scripts/bing-stats.js (perf, crawl, sitemaps, inspect, submit).
# ⚠️ Propriété configurée sur l'APEX diy-builder.fr (SANS www).
# Obtenir sur https://www.bing.com/webmasters → Paramètres → Accès API (clé 32 car.).
BING_API_KEY=

# IndexNow — clé de soumission instantanée pour scripts/indexnow-submit.js
# (Bing/Yandex/Seznam/Naver ; PAS Google). Clé hex 32-128 car.
# ⚠️ DOIT être servie publiquement à https://www.diy-builder.fr/<clé>.txt
# (frontend/public/<clé>.txt contient la clé en clair). Générer : openssl rand -hex 16
INDEXNOW_KEY=

# Umami self-host — lecture API pour scripts/umami-stats.js (audience, events).
# URL + WEBSITE_ID visibles dans le HTML live (non secrets). USER défaut = admin.
# PASSWORD = mot de passe admin de l'instance (secret, non récupérable sur disque).
UMAMI_SELFHOST_URL=
UMAMI_SELFHOST_USER=admin
UMAMI_SELFHOST_PASSWORD=
UMAMI_SELFHOST_WEBSITE_ID=

# GSC (Google Search Console) — scripts/gsc-stats.js n'utilise PAS de clé .env :
# auth via gcloud ADC utilisateur (`gcloud auth application-default login`).
# Voir .claude/setup/gsc-bing-setup.md.
