# ───────────────────────────────────────────────────────────────────
# Variables d'environnement — DIY Builder
#
# Copier ce fichier vers .env.local et remplir les valeurs réelles.
# .env.local est gitignored — ne JAMAIS commit de secrets.
# ───────────────────────────────────────────────────────────────────

# ── Analytics (client-side, public) ────────────────────────────────

# Analytics Umami — privacy-first, CNIL-exempt (pas de bannière de consentement)
# Obtenir sur https://cloud.umami.is → Settings → Website → Website ID
# Laisser vide en dev pour désactiver le tracking.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Meta Pixel (Facebook/Instagram) — ID public, chargé après consentement RGPD.
# Laisser vide pour désactiver complètement le pixel.
NEXT_PUBLIC_META_PIXEL_ID=

# ── Backend (server-only, secret) ──────────────────────────────────

# Resend API key — envoi d'emails transactionnels (devis, leads).
# Obtenir sur https://resend.com/api-keys
# Format : re_xxxxxxxxxxxx
RESEND_API_KEY=

# Adresse de réception des notifications de leads (admin/owner).
# Défaut : contact@diy-builder.fr si non défini.
LEAD_NOTIFY_EMAIL=

# Redis (Vercel KV / Upstash / self-hosted ioredis-compatible).
# Format : redis://... ou rediss://... (TLS).
# Auto-injecté par Vercel Storage si l'intégration est branchée.
REDIS_URL=

# Mot de passe admin pour /api/admin/leads (Basic Auth).
# REQUIS : minimum 16 caractères. Sinon l'endpoint est verrouillé.
# Générer un mot de passe long : `openssl rand -base64 24`
ADMIN_PASSWORD=
